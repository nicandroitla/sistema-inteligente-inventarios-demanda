@page
@model IndexModel

@{
    ViewData["Title"] = "Dashboard";
}

<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />

<div class="pro-dashboard">

    <div class="db-header">
        <div>
            <h1>Dashboard</h1>
            <p>Supervisión inteligente de inventarios y demanda.</p>
        </div>

        <button type="button" class="db-refresh" id="btnActualizarDashboard">
            ↻ Actualizar datos
        </button>
    </div>

    <div class="db-kpi-grid">

        <div class="db-kpi" style="--accent: #2563eb;">
            <div class="db-kpi-icon">▦</div>
            <div class="db-kpi-label">Total de productos</div>
            <div class="db-kpi-value" id="totalProductos">—</div>
            <div class="db-kpi-description">Productos registrados</div>
        </div>

        <div class="db-kpi" style="--accent: #d97706;">
            <div class="db-kpi-icon">△</div>
            <div class="db-kpi-label">Stock bajo</div>
            <div class="db-kpi-value" id="productosStockBajo">—</div>
            <div class="db-kpi-description">Requieren atención</div>
        </div>

        <div class="db-kpi" style="--accent: #dc2626;">
            <div class="db-kpi-icon">⊘</div>
            <div class="db-kpi-label">Sin stock</div>
            <div class="db-kpi-value" id="productosSinStock">—</div>
            <div class="db-kpi-description">Productos agotados</div>
        </div>

        <div class="db-kpi" style="--accent: #16a34a;">
            <div class="db-kpi-icon">$</div>
            <div class="db-kpi-label">Valor del inventario</div>
            <div class="db-kpi-value" id="valorInventario">—</div>
            <div class="db-kpi-description">Valor estimado actual</div>
        </div>

        <div class="db-kpi" style="--accent: #0891b2;">
            <div class="db-kpi-icon">▤</div>
            <div class="db-kpi-label">Unidades disponibles</div>
            <div class="db-kpi-value" id="totalUnidades">—</div>
            <div class="db-kpi-description">Existencias totales</div>
        </div>

        <div class="db-kpi" style="--accent: #7c3aed;">
            <div class="db-kpi-icon">↑</div>
            <div class="db-kpi-label">Exceso de stock</div>
            <div class="db-kpi-value" id="productosExcesoStock">—</div>
            <div class="db-kpi-description">Superan el máximo permitido</div>
        </div>

        <div class="db-kpi" style="--accent: #2563eb;">
            <div class="db-kpi-icon">↙</div>
            <div class="db-kpi-label">Entradas</div>
            <div class="db-kpi-value" id="totalEntradas">—</div>
            <div class="db-kpi-description">Unidades en los últimos 7 días</div>
        </div>

        <div class="db-kpi" style="--accent: #0d9488;">
            <div class="db-kpi-icon">↗</div>
            <div class="db-kpi-label">Salidas</div>
            <div class="db-kpi-value" id="totalSalidas">—</div>
            <div class="db-kpi-description">Unidades en los últimos 7 días</div>
        </div>

    </div>

    <div class="db-chart-grid">

        <section class="db-panel">
            <h2>Movimientos de inventario</h2>
            <p class="db-subtitle">
                Entradas y salidas de los últimos siete días.
            </p>

            <div class="db-bar-chart" id="graficoMovimientos">
                <div class="db-empty-message">Cargando movimientos...</div>
            </div>

            <div class="db-legend">
                <div class="db-legend-item">
                    <span class="db-color" style="background: #2563eb;"></span>
                    Entradas
                </div>

                <div class="db-legend-item">
                    <span class="db-color" style="background: #14b8a6;"></span>
                    Salidas
                </div>
            </div>
        </section>

        <section class="db-panel">
            <h2>Distribución del inventario</h2>
            <p class="db-subtitle">
                Unidades disponibles por categoría.
            </p>

            <div class="db-donut" id="graficoDistribucion">
                <div class="db-donut-center">
                    <strong id="donutTotal">—</strong>
                    <small>Unidades</small>
                </div>
            </div>

            <div id="leyendaDistribucion">
                <div class="db-empty-message">Cargando categorías...</div>
            </div>
        </section>

    </div>

    <div class="db-chart-grid">

        <section class="db-panel">
            <h2>Productos con mayores salidas</h2>
            <p class="db-subtitle">
                Top 5 productos durante los últimos siete días.
            </p>

            <div id="rankingDemanda">
                <div class="db-empty-message">Cargando ranking...</div>
            </div>
        </section>

        <section class="db-panel">
            <h2>Estado de existencias</h2>
            <p class="db-subtitle">
                Disponibilidad actual respecto al stock máximo.
            </p>

            <div id="estadoExistencias">
                <div class="db-empty-message">Cargando existencias...</div>
            </div>
        </section>

    </div>

    <div class="db-system">

        <div class="db-system-status" role="status" aria-live="polite">
            <span class="db-dot" id="indicadorEstado"></span>
            <span id="estadoSistema">Conectando con la API...</span>
        </div>

        <div class="db-update">
            Última actualización:
            <strong id="ultimaActualizacion">—</strong>
        </div>

    </div>

</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
