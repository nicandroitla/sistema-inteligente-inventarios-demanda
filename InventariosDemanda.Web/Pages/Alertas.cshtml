@page
@{
    ViewData["Title"] = "Alertas inteligentes";
}

<link rel="stylesheet"
      href="~/css/alertas.css"
      asp-append-version="true" />

<div class="pro-alertas">

    <div class="al-header">
        <div>
            <h1>Alertas inteligentes</h1>
            <p>Monitoreo preventivo y control de riesgos del inventario.</p>
        </div>

        <button id="botonActualizar"
                class="btn btn-outline-primary"
                type="button">
            Actualizar alertas
        </button>
    </div>

    <div id="mensaje"
         class="alert d-none"
         role="status"
         aria-live="polite">
    </div>

    <!-- INDICADORES PRINCIPALES -->

    <div class="al-kpi-grid">

        <div class="al-kpi al-blue">
            <div class="al-kpi-label">Alertas activas</div>
            <div id="totalAlertas" class="al-kpi-value">—</div>
            <div class="al-kpi-detail">Productos que requieren atencion</div>
        </div>

        <div class="al-kpi al-red">
            <div class="al-kpi-label">Productos agotados</div>
            <div id="totalAgotados" class="al-kpi-value">—</div>
            <div class="al-kpi-detail">Prioridad critica</div>
        </div>

        <div class="al-kpi al-orange">
            <div class="al-kpi-label">Stock bajo</div>
            <div id="totalStockBajo" class="al-kpi-value">—</div>
            <div class="al-kpi-detail">Existencias en el limite minimo</div>
        </div>

        <div class="al-kpi al-red">
            <div class="al-kpi-label">Riesgo de agotamiento</div>
            <div id="totalRiesgoAgotamiento" class="al-kpi-value">—</div>
            <div class="al-kpi-detail">Alerta principal por cobertura de hasta 7 dias</div>
        </div>

        <div class="al-kpi al-yellow">
            <div class="al-kpi-label">Reposicion preventiva</div>
            <div id="totalReposicionPreventiva" class="al-kpi-value">—</div>
            <div class="al-kpi-detail">Abastecimiento anticipado</div>
        </div>

        <div class="al-kpi al-purple">
            <div class="al-kpi-label">Exceso de stock</div>
            <div id="totalExcesoStock" class="al-kpi-value">—</div>
            <div class="al-kpi-detail">Existencias superiores al maximo</div>
        </div>

        <div class="al-kpi al-cyan">
            <div class="al-kpi-label">Unidades a reponer</div>
            <div id="totalUnidadesReposicion" class="al-kpi-value">—</div>
            <div class="al-kpi-detail">Cantidad total recomendada</div>
        </div>

        <div class="al-kpi al-green">
            <div class="al-kpi-label">Productos sin alertas</div>
            <div id="productosSinAlertas" class="al-kpi-value">—</div>
            <div class="al-kpi-detail">Sin alertas segun las reglas actuales</div>
        </div>

    </div>

    <!-- DISTRIBUCION POR PRIORIDAD -->

    <section class="al-panel">

        <h2>Distribucion por prioridad</h2>

        <p class="al-description">
            Clasificacion de las alertas segun su nivel de importancia.
        </p>

        <div id="graficoPrioridades">
            <div class="al-empty">
                Cargando distribucion de alertas...
            </div>
        </div>

    </section>

    <!-- METODO DE ANALISIS -->

    <div class="al-method">

        <strong>Motor de alertas inteligentes</strong>

        <div class="mt-2">
            Las alertas se generan utilizando las existencias actuales,
            los limites de inventario y las predicciones de demanda
            basadas en el consumo historico.
        </div>

        <div id="periodoAnalisis" class="mt-2">
            Consultando periodo de analisis...
        </div>

    </div>

    <!-- CENTRO DE ALERTAS -->

    <section class="al-panel">

        <h2>Centro de alertas</h2>

        <p class="al-description">
            Consulta los productos que requieren atencion y sus
            recomendaciones de abastecimiento.
        </p>

        <div class="al-filters">

            <div>
                <label for="buscarProducto" class="form-label">
                    Buscar producto
                </label>

                <input id="buscarProducto"
                       type="search"
                       class="form-control"
                       placeholder="Nombre o categoria..." />
            </div>

            <div>
                <label for="filtroTipo" class="form-label">
                    Tipo de alerta
                </label>

                <select id="filtroTipo" class="form-select">
                    <option value="">Todos los tipos</option>
                    <option value="Agotado">Agotado</option>
                    <option value="Stock bajo">Stock bajo</option>
                    <option value="Riesgo de agotamiento">
                        Riesgo de agotamiento
                    </option>
                    <option value="Reposicion preventiva">
                        Reposicion preventiva
                    </option>
                    <option value="Exceso de stock">
                        Exceso de stock
                    </option>
                </select>
            </div>

            <div>
                <label for="filtroPrioridad" class="form-label">
                    Prioridad
                </label>

                <select id="filtroPrioridad" class="form-select">
                    <option value="">Todas las prioridades</option>
                    <option value="Critica">Critica</option>
                    <option value="Alta">Alta</option>
                    <option value="Media">Media</option>
                    <option value="Informativa">Informativa</option>
                </select>
            </div>

        </div>

        <div class="al-toolbar">

            <span id="contadorAlertas"
                  class="al-counter"
                  aria-live="polite">
                Consultando alertas...
            </span>

            <button id="btnLimpiarFiltros"
                    type="button"
                    class="btn btn-sm btn-outline-secondary">
                Limpiar filtros
            </button>

        </div>

        <div id="listaAlertas" class="al-alert-list">

            <div class="al-empty">
                Cargando alertas del inventario...
            </div>

        </div>

    </section>

    <!-- INFORMACION COMPLEMENTARIA -->

    <section class="al-panel">

        <h2>Consideraciones del analisis</h2>

        <p class="al-description mb-2">
            Las recomendaciones se calculan automaticamente
            a partir de la informacion registrada en el sistema.
        </p>

        <ul class="text-secondary small mb-0">
            <li>
                Cada producto presenta una alerta principal
                para evitar duplicidades.
            </li>

            <li>
                Las predicciones son estimaciones y no garantizan
                el comportamiento futuro de la demanda.
            </li>

            <li>
                La ausencia de salidas historicas no implica
                ausencia de demanda futura.
            </li>

            <li>
                El valor referencial de reposicion utiliza
                los precios registrados en el inventario.
            </li>

            <li>
                Las alertas se recalculan al consultar
                o actualizar este modulo.
            </li>
        </ul>

    </section>

    <div id="ultimaActualizacion" class="al-footer">
        Ultima actualizacion: pendiente
    </div>

</div>

@section Scripts {
    <script src="~/js/alertas.js"
            asp-append-version="true"></script>
}
