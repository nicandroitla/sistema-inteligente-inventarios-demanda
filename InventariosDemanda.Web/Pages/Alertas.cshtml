@page
@{
    ViewData["Title"] = "Alertas de inventario";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Alertas de inventario</h1>
            <p class="text-secondary mb-0">
                Identifica productos agotados o con existencias por debajo del mínimo.
            </p>
        </div>
        <button class="btn btn-outline-secondary" type="button" onclick="cargarAlertas()">
            Actualizar alertas
        </button>
    </div>

    <div id="mensaje" class="alert d-none" role="alert"></div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <p class="text-secondary mb-1">Productos agotados</p>
                    <div id="totalAgotados" class="display-6 fw-bold text-danger">0</div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <p class="text-secondary mb-1">Productos con stock bajo</p>
                    <div id="totalStockBajo" class="display-6 fw-bold text-warning">0</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <h2 class="h5 fw-bold text-danger mb-3">Productos agotados</h2>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Categoría</th>
                            <th>Stock actual</th>
                            <th>Stock mínimo</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody id="tablaAgotados">
                        <tr>
                            <td colspan="5" class="text-center text-secondary">
                                Cargando datos...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <h2 class="h5 fw-bold text-warning mb-3">Productos con stock bajo</h2>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Categoría</th>
                            <th>Stock actual</th>
                            <th>Stock mínimo</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody id="tablaStockBajo">
                        <tr>
                            <td colspan="5" class="text-center text-secondary">
                                Cargando datos...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const apiAlertas = "http://localhost:5014/api/alertas";

        function mostrarMensaje(texto, tipo) {
            const mensaje = document.getElementById("mensaje");
            mensaje.textContent = texto;
            mensaje.className = `alert alert-${tipo}`;
        }

        function crearFila(producto, tabla) {
            const fila = tabla.insertRow();

            [
                producto.nombre,
                producto.categoria,
                producto.stockActual,
                producto.stockMinimo,
                producto.mensaje
            ].forEach((valor, indice) => {
                const celda = fila.insertCell();
                celda.textContent = valor ?? "";

                if (indice === 4) {
                    celda.className = producto.mensaje === "Producto agotado"
                        ? "text-danger fw-semibold"
                        : "text-warning fw-semibold";
                }
            });
        }

        function mostrarProductos(productos, idTabla, mensajeVacio) {
            const tabla = document.getElementById(idTabla);
            tabla.replaceChildren();

            if (!productos || productos.length === 0) {
                const fila = tabla.insertRow();
                const celda = fila.insertCell();
                celda.colSpan = 5;
                celda.className = "text-center text-secondary";
                celda.textContent = mensajeVacio;
                return;
            }

            productos.forEach(producto => crearFila(producto, tabla));
        }

        async function cargarAlertas() {
            const mensaje = document.getElementById("mensaje");
            mensaje.textContent = "";
            mensaje.className = "alert d-none";

            try {
                const respuesta = await fetch(apiAlertas);

                if (!respuesta.ok) {
                    throw new Error("No se pudieron consultar las alertas.");
                }

                const datos = await respuesta.json();

                document.getElementById("totalAgotados").textContent =
                    datos.totalAgotados ?? datos.TotalAgotados ?? 0;

                document.getElementById("totalStockBajo").textContent =
                    datos.totalStockBajo ?? datos.TotalStockBajo ?? 0;

                mostrarProductos(
                    datos.productosAgotados ?? datos.ProductosAgotados ?? [],
                    "tablaAgotados",
                    "No hay productos agotados."
                );

                mostrarProductos(
                    datos.productosStockBajo ?? datos.ProductosStockBajo ?? [],
                    "tablaStockBajo",
                    "No hay productos con stock bajo."
                );
            } catch (error) {
                mostrarMensaje(
                    error.message + " Verifica que la API esté ejecutándose.",
                    "danger"
                );
            }
        }

        cargarAlertas();
    </script>
}