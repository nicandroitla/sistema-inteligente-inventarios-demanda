@page
@model DemandaModel
@{
    ViewData["Title"] = "Demanda inteligente";
}

<link rel="stylesheet" href="~/css/demanda.css" asp-append-version="true" />

<div class="pro-demanda">

    <!-- ENCABEZADO -->

    <div class="dm-header">
        <div>
            <h1>Demanda inteligente</h1>
            <p>Analisis predictivo y planificacion de inventario.</p>
        </div>

        <button id="botonActualizar"
                type="button"
                class="btn btn-outline-primary">
            Actualizar analisis
        </button>
    </div>

    <div id="mensaje"
         class="alert d-none"
         role="status"
         aria-live="polite">
    </div>

    <!-- INDICADORES -->

    <div class="dm-kpi-grid">

        <div class="dm-kpi dm-blue">
            <div class="dm-kpi-label">Productos analizados</div>
            <div id="totalProductos" class="dm-kpi-value">—</div>
            <div class="dm-kpi-detail">Catalogo de inventario</div>
        </div>

        <div class="dm-kpi dm-purple">
            <div class="dm-kpi-label">Salidas historicas</div>
            <div id="totalSalidas" class="dm-kpi-value">—</div>
            <div class="dm-kpi-detail">Ultimos 30 dias completos</div>
        </div>

        <div class="dm-kpi dm-orange">
            <div class="dm-kpi-label">Requieren reposicion</div>
            <div id="productosRequierenReposicion" class="dm-kpi-value">—</div>
            <div class="dm-kpi-detail">Segun demanda proyectada</div>
        </div>

        <div class="dm-kpi dm-red">
            <div class="dm-kpi-label">Productos en riesgo</div>
            <div id="productosEnRiesgo" class="dm-kpi-value">—</div>
            <div class="dm-kpi-detail">Agotados o cobertura de hasta 7 dias</div>
        </div>

        <div class="dm-kpi dm-cyan">
            <div class="dm-kpi-label">Demanda a 30 dias</div>
            <div id="demandaTotal30Dias" class="dm-kpi-value">—</div>
            <div class="dm-kpi-detail">Unidades proyectadas</div>
        </div>

        <div class="dm-kpi dm-green">
            <div class="dm-kpi-label">Unidades a reponer</div>
            <div id="totalUnidadesReposicion" class="dm-kpi-value">—</div>
            <div class="dm-kpi-detail">Cantidad total recomendada</div>
        </div>

        <div class="dm-kpi dm-blue">
            <div class="dm-kpi-label">Valor referencial de reposicion</div>
            <div id="costoTotalReposicion" class="dm-kpi-value">—</div>
            <div class="dm-kpi-detail">Segun precios registrados</div>
        </div>

        <div class="dm-kpi dm-gray">
            <div class="dm-kpi-label">Sin salidas registradas</div>
            <div id="productosSinSalidas" class="dm-kpi-value">—</div>
            <div class="dm-kpi-detail">Sin consumo observado en el periodo</div>
        </div>

    </div>

    <!-- GRAFICOS -->

    <div class="dm-charts-grid">

        <section class="dm-panel">

            <h2>Proyeccion de demanda</h2>

            <p class="dm-panel-description">
                Consumo estimado para los proximos 7, 15 y 30 dias.
            </p>

            <div id="graficoProyecciones">
                <p class="text-secondary">Cargando proyecciones...</p>
            </div>

        </section>

        <section class="dm-panel">

            <h2>Productos con mayor demanda historica</h2>

            <p class="dm-panel-description">
                Clasificacion segun unidades retiradas durante el periodo.
            </p>

            <div id="graficoRanking">
                <p class="text-secondary">Cargando productos...</p>
            </div>

        </section>

    </div>

    <!-- INFORMACION DEL MODELO -->

    <div class="dm-method">

        <strong>Modelo predictivo utilizado</strong>

        Las estimaciones se calculan mediante el promedio diario
        de salidas de los ultimos 30 dias completos.

        El modelo supone que el ritmo de consumo observado
        se mantiene durante los proximos dias.

        <div id="periodoAnalisis" class="dm-period">
            Consultando periodo...
        </div>

    </div>

    <!-- PREDICCIONES POR PRODUCTO -->

    <section class="dm-panel">

        <h2>Predicciones por producto</h2>

        <p class="dm-panel-description">
            Analiza el consumo historico, la demanda futura estimada
            y la cobertura de existencias.
        </p>

        <div class="dm-filters">

            <div>
                <label for="buscarProducto">Buscar producto</label>

                <input id="buscarProducto"
                       type="search"
                       class="form-control"
                       placeholder="Nombre del producto..." />
            </div>

            <div>
                <label for="filtroNivel">Nivel de demanda</label>

                <select id="filtroNivel" class="form-select">
                    <option value="">Todos los niveles</option>
                    <option value="Alta">Alta</option>
                    <option value="Media">Media</option>
                    <option value="Baja">Baja</option>
                    <option value="Sin salidas">Sin salidas</option>
                </select>
            </div>

            <div>
                <label for="filtroEstado">Estado del inventario</label>

                <select id="filtroEstado" class="form-select">
                    <option value="">Todos los estados</option>
                    <option value="Agotado">Agotado</option>
                    <option value="Stock bajo">Stock bajo</option>
                    <option value="Riesgo de agotamiento">Riesgo de agotamiento</option>
                    <option value="Reposicion preventiva">Reposicion preventiva</option>
                    <option value="Stock suficiente">Stock suficiente</option>
                    <option value="Exceso de stock">Exceso de stock</option>
                </select>
            </div>

        </div>

        <div class="dm-toolbar">

            <span id="contadorProductos" class="dm-counter">
                Consultando productos...
            </span>

            <button id="btnLimpiarFiltros"
                    type="button"
                    class="btn btn-sm btn-outline-secondary">
                Limpiar filtros
            </button>

        </div>

        <div class="table-responsive">

            <table class="table dm-table">

                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Salidas (uds.)</th>
                        <th>Promedio diario</th>
                        <th>7 dias</th>
                        <th>15 dias</th>
                        <th>30 dias</th>
                        <th>Cobertura</th>
                        <th>Participacion</th>
                        <th>Nivel</th>
                    </tr>
                </thead>

                <tbody id="tablaPredicciones">
                    <tr>
                        <td colspan="9" class="dm-empty-message">
                            Cargando predicciones...
                        </td>
                    </tr>
                </tbody>

            </table>

        </div>

    </section>

    <!-- PLAN DE REPOSICION -->

    <section class="dm-panel">

        <h2>Plan de reposicion inteligente</h2>

        <p class="dm-panel-description">
            Recomendaciones para cubrir la demanda mensual estimada
            y conservar el stock minimo, respetando el stock maximo.
        </p>

        <div class="table-responsive">

            <table class="table dm-table">

                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Stock actual</th>
                        <th>Minimo</th>
                        <th>Maximo</th>
                        <th>Stock objetivo</th>
                        <th>Reponer</th>
                        <th>Objetivo no cubierto</th>
                        <th>Valor referencial</th>
                        <th>Estado</th>
                    </tr>
                </thead>

                <tbody id="tablaReposicion">
                    <tr>
                        <td colspan="9" class="dm-empty-message">
                            Calculando reposicion...
                        </td>
                    </tr>
                </tbody>

            </table>

        </div>

    </section>

    <!-- LIMITACIONES -->

    <div class="dm-method">

        <strong>Consideraciones del analisis</strong>

        Las proyecciones son estimaciones estadisticas,
        no garantias de ventas futuras.

        Las salidas de prueba tambien influyen en los resultados.
        La ausencia de salidas no garantiza que no exista demanda.

        El valor de reposicion utiliza el precio registrado,
        no necesariamente el costo de compra al proveedor.

    </div>

    <div id="ultimaActualizacion" class="dm-footer">
        Ultima actualizacion: pendiente
    </div>

</div>

@section Scripts {
    <script src="~/js/demanda.js" asp-append-version="true"></script>
}
