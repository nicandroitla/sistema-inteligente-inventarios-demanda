
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#111827" />
    <title>@ViewData["Title"] - Inventarios Inteligentes</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "/Index";
    }

    <div class="app-container">
        <aside class="sidebar">
            <a asp-page="/Index" class="sidebar-brand">
                <span class="brand-icon">I</span>
                <span class="brand-copy">
                    <span class="brand-title">Inventarios</span>
                    <span class="brand-subtitle">INTELLIGENCE SYSTEM</span>
                </span>
            </a>

            <div class="sidebar-section-label">MENÚ PRINCIPAL</div>

            <nav class="sidebar-nav" aria-label="Navegación principal">
                <a asp-page="/Index"
                   class="sidebar-link @(currentPage == "/Index" || currentPage == "/" ? "active" : "")"
                   aria-current="@(currentPage == "/Index" || currentPage == "/" ? "page" : null)">
                    <span class="menu-icon" aria-hidden="true">▦</span>
                    <span>Dashboard</span>
                </a>

                <a asp-page="/Productos"
                   class="sidebar-link @(currentPage == "/Productos" ? "active" : "")"
                   aria-current="@(currentPage == "/Productos" ? "page" : null)">
                    <span class="menu-icon" aria-hidden="true">▤</span>
                    <span>Productos</span>
                </a>

                <a asp-page="/Movimientos"
                   class="sidebar-link @(currentPage == "/Movimientos" ? "active" : "")"
                   aria-current="@(currentPage == "/Movimientos" ? "page" : null)">
                    <span class="menu-icon" aria-hidden="true">⇄</span>
                    <span>Movimientos</span>
                </a>

                <a asp-page="/Demanda"
                   class="sidebar-link @(currentPage == "/Demanda" ? "active" : "")"
                   aria-current="@(currentPage == "/Demanda" ? "page" : null)">
                    <span class="menu-icon" aria-hidden="true">⌁</span>
                    <span>Demanda</span>
                </a>

                <a asp-page="/Alertas"
                   class="sidebar-link @(currentPage == "/Alertas" ? "active" : "")"
                   aria-current="@(currentPage == "/Alertas" ? "page" : null)">
                    <span class="menu-icon" aria-hidden="true">△</span>
                    <span>Alertas</span>
                </a>
            </nav>

            <div class="sidebar-help">
                <span class="help-icon" aria-hidden="true">✦</span>
                <div>
                    <strong>Control inteligente</strong>
                    <p>Organiza y supervisa tu inventario.</p>
                </div>
            </div>

            <div class="sidebar-footer">
                <div class="profile-avatar">N</div>
                <div class="profile-info">
                    <strong>Nicandro de los Santos</strong>
                    <span>Administrador del proyecto</span>
                    <small>Matrícula: 2023-1814</small>
                </div>
            </div>
        </aside>

        <div class="workspace">
            <header class="topbar">
                <div class="topbar-heading">
                    <span class="topbar-eyebrow">PLATAFORMA DE GESTIÓN</span>
                    <span class="topbar-title">Panel de inventario</span>
                </div>

                <div class="topbar-right">
                    <span class="environment-label">
                        <span class="status-dot"></span>
                        Entorno local
                    </span>
                    <span class="topbar-avatar" aria-label="Perfil de Nicandro">N</span>
                </div>
            </header>

            <main class="main-content">
                <div class="page-container">
                    @RenderBody()
                </div>

                <footer class="app-footer">
                    <span>Sistema Inteligente de Gestión de Inventarios y Demanda</span>
                    <span>Proyecto académico · 2026</span>
                </footer>
            </main>
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
