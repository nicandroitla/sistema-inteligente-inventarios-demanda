@page
@{
    ViewData["Title"] = "Movimientos de inventario";
}

<link rel="stylesheet" href="~/css/movimientos.css" asp-append-version="true" />

<div class="pro-movimientos">

    <div class="mv-header">
        <div>
            <h1>Movimientos de inventario</h1>
            <p>Control inteligente de entradas, salidas y existencias.</p>
        </div>

        <button type="button"
                id="botonActualizar"
                class="btn btn-outline-primary"
                onclick="cargarDatos()">
            Actualizar
        </button>
    </div>

    <!-- INDICADORES -->

    <div class="mv-kpi-grid">

        <div class="mv-kpi" style="--accent: #2563eb;">
            <div class="mv-kpi-label">Total de movimientos</div>
            <div class="mv-kpi-value" id="totalMovimientos">—</div>
        </div>

        <div class="mv-kpi" style="--accent: #16a34a;">
            <div class="mv-kpi-label">Unidades ingresadas</div>
            <div class="mv-kpi-value" id="totalEntradas">—</div>
        </div>

        <div class="mv-kpi" style="--accent: #dc2626;">
            <div class="mv-kpi-label">Unidades retiradas</div>
            <div class="mv-kpi-value" id="totalSalidas">—</div>
        </div>

        <div class="mv-kpi" style="--accent: #7c3aed;">
            <div class="mv-kpi-label">Balance neto histórico</div>
            <div class="mv-kpi-value" id="balanceNeto">—</div>
        </div>

    </div>

    <!-- MENSAJES -->

    <div id="mensaje"
         class="alert d-none"
         role="status"
         aria-live="polite">
    </div>

    <!-- FORMULARIO -->

    <section class="mv-panel">

        <h2>Registrar movimiento</h2>

        <p class="text-muted small mb-4">
            Registra una entrada o salida para actualizar las existencias.
        </p>

        <form id="formularioMovimiento">

            <div class="row g-3">

                <div class="col-md-6">

                    <label for="productoId" class="form-label">
                        Producto
                    </label>

                    <select id="productoId"
                            class="form-select"
                            required>
                        <option value="">
                            Cargando productos...
                        </option>
                    </select>

                    <div class="form-text">
                        Productos registrados:
                        <strong id="totalProductos">—</strong>
                    </div>

                </div>

                <div class="col-md-3">

                    <label for="tipo" class="form-label">
                        Tipo de movimiento
                    </label>

                    <select id="tipo"
                            class="form-select"
                            required>
                        <option value="ENTRADA">Entrada</option>
                        <option value="SALIDA">Salida</option>
                    </select>

                </div>

                <div class="col-md-3">

                    <label for="cantidad" class="form-label">
                        Cantidad
                    </label>

                    <input id="cantidad"
                           type="number"
                           class="form-control"
                           placeholder="Ej. 5"
                           min="1"
                           step="1"
                           required />

                </div>

                <div class="col-12">

                    <label for="descripcion" class="form-label">
                        Descripción
                    </label>

                    <input id="descripcion"
                           type="text"
                           class="form-control"
                           maxlength="250"
                           placeholder="Motivo del movimiento (opcional)" />

                </div>

                <div class="col-12 mt-4">

                    <button id="botonGuardar"
                            type="submit"
                            class="btn btn-primary">
                        Registrar movimiento
                    </button>

                </div>

            </div>

        </form>

    </section>

    <!-- HISTORIAL Y FILTROS -->

    <section class="mv-panel">

        <h2>Historial de movimientos</h2>

        <p class="text-muted small mb-4">
            Consulta y filtra las operaciones realizadas en el inventario.
        </p>

        <div class="mv-filters">

            <div>

                <label for="buscarMovimiento" class="form-label">
                    Buscar producto
                </label>

                <input type="search"
                       id="buscarMovimiento"
                       class="form-control"
                       placeholder="Nombre del producto..."
                       autocomplete="off" />

            </div>

            <div>

                <label for="filtroTipo" class="form-label">
                    Tipo de movimiento
                </label>

                <select id="filtroTipo" class="form-select">
                    <option value="">Todos los tipos</option>
                    <option value="ENTRADA">Entradas</option>
                    <option value="SALIDA">Salidas</option>
                </select>

            </div>

            <div>

                <label for="fechaDesde" class="form-label">
                    Desde
                </label>

                <input type="date"
                       id="fechaDesde"
                       class="form-control" />

            </div>

            <div>

                <label for="fechaHasta" class="form-label">
                    Hasta
                </label>

                <input type="date"
                       id="fechaHasta"
                       class="form-control" />

            </div>

        </div>

        <div id="mensajeFiltros"
             class="text-danger small mb-3"
             role="status"
             aria-live="polite">
        </div>

        <div class="mv-toolbar">

            <span id="contadorMovimientos"
                  class="mv-counter"
                  aria-live="polite">
                Cargando movimientos...
            </span>

            <button type="button"
                    id="btnLimpiarFiltros"
                    class="btn btn-sm btn-outline-secondary">
                Limpiar filtros
            </button>

        </div>

        <div class="table-responsive">

            <table class="table mv-table align-middle">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Fecha</th>
                        <th>Producto</th>
                        <th>Tipo</th>
                        <th>Cantidad</th>
                        <th>Descripción</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody id="tablaMovimientos">

                    <tr>
                        <td colspan="7" class="mv-empty-message">
                            Cargando movimientos...
                        </td>
                    </tr>

                </tbody>

            </table>

        </div>

    </section>

</div>

@section Scripts {
    <script src="~/js/movimientos.js" asp-append-version="true"></script>
}
