@page
@{
    ViewData["Title"] = "Productos";
}

<link rel="stylesheet" href="~/css/productos.css" asp-append-version="true" />

<div class="pro-productos">

    <div class="pr-header">
        <div>
            <h1>Productos</h1>
            <p>Gestión inteligente de los productos del inventario.</p>
        </div>

        <button type="button"
                class="btn btn-primary"
                onclick="mostrarFormulario()">
            + Nuevo producto
        </button>
    </div>

    <div class="pr-kpi-grid">

        <div class="pr-kpi" style="--accent: #2563eb;">
            <div class="pr-kpi-label">Total de productos</div>
            <div class="pr-kpi-value" id="prTotal">—</div>
        </div>

        <div class="pr-kpi" style="--accent: #16a34a;">
            <div class="pr-kpi-label">Stock suficiente</div>
            <div class="pr-kpi-value" id="prDisponibles">—</div>
        </div>

        <div class="pr-kpi" style="--accent: #d97706;">
            <div class="pr-kpi-label">Stock bajo</div>
            <div class="pr-kpi-value" id="prStockBajo">—</div>
        </div>

        <div class="pr-kpi" style="--accent: #dc2626;">
            <div class="pr-kpi-label">Agotados</div>
            <div class="pr-kpi-value" id="prAgotados">—</div>
        </div>

    </div>

    <div id="mensaje"
         class="mb-3"
         role="status"
         aria-live="polite">
    </div>

    <!-- FORMULARIO DE PRODUCTOS -->

    <section class="pr-panel"
             id="formularioProducto"
             style="display: none;">

        <h2 id="tituloFormulario">Registrar producto</h2>

        <p class="text-muted small mb-4">
            Completa la información del producto.
        </p>

        <input type="hidden" id="productoId" />

        <div class="row g-3">

            <div class="col-md-6">
                <label for="nombre" class="form-label">
                    Nombre del producto
                </label>

                <input type="text"
                       id="nombre"
                       class="form-control"
                       placeholder="Ej. Laptop Dell"
                       maxlength="150" />
            </div>

            <div class="col-md-6">
                <label for="categoria" class="form-label">
                    Categoría
                </label>

                <input type="text"
                       id="categoria"
                       class="form-control"
                       placeholder="Ej. Computadoras"
                       maxlength="100" />
            </div>

            <div class="col-md-4">
                <label for="stockActual" class="form-label">
                    Stock actual
                </label>

                <input type="number"
                       id="stockActual"
                       class="form-control"
                       min="0"
                       step="1" />
            </div>

            <div class="col-md-4">
                <label for="stockMinimo" class="form-label">
                    Stock mínimo
                </label>

                <input type="number"
                       id="stockMinimo"
                       class="form-control"
                       min="0"
                       step="1" />
            </div>

            <div class="col-md-4">
                <label for="stockMaximo" class="form-label">
                    Stock máximo
                </label>

                <input type="number"
                       id="stockMaximo"
                       class="form-control"
                       min="0"
                       step="1" />
            </div>

            <div class="col-md-4">
                <label for="precio" class="form-label">
                    Precio unitario
                </label>

                <input type="number"
                       id="precio"
                       class="form-control"
                       min="0"
                       step="0.01" />
            </div>

        </div>

        <div class="d-flex flex-wrap gap-2 mt-4">

            <button type="button"
                    id="btnGuardar"
                    class="btn btn-primary"
                    onclick="guardarProducto()">
                Guardar
            </button>

            <button type="button"
                    class="btn btn-outline-secondary"
                    onclick="cancelarFormulario()">
                Cancelar
            </button>

        </div>

    </section>

    <!-- LISTADO Y FILTROS -->

    <section class="pr-panel">

        <h2>Catálogo de productos</h2>

        <p class="text-muted small mb-4">
            Consulta, filtra y administra las existencias.
        </p>

        <div class="pr-filters">

            <div>
                <label for="buscarProducto" class="form-label">
                    Buscar producto
                </label>

                <input type="search"
                       id="buscarProducto"
                       class="form-control"
                       placeholder="Escribe el nombre del producto..."
                       autocomplete="off" />
            </div>

            <div>
                <label for="filtroCategoria" class="form-label">
                    Categoría
                </label>

                <select id="filtroCategoria" class="form-select">
                    <option value="">Todas las categorías</option>
                </select>
            </div>

            <div>
                <label for="filtroEstado" class="form-label">
                    Estado del stock
                </label>

                <select id="filtroEstado" class="form-select">
                    <option value="">Todos los estados</option>
                    <option value="normal">Stock suficiente</option>
                    <option value="bajo">Stock bajo</option>
                    <option value="agotado">Agotado</option>
                    <option value="exceso">Exceso de stock</option>
                </select>
            </div>

        </div>

        <div class="pr-toolbar">

            <span id="contadorProductos"
                  class="pr-counter"
                  aria-live="polite">
                Cargando productos...
            </span>

            <button type="button"
                    id="btnLimpiarFiltros"
                    class="btn btn-sm btn-outline-secondary">
                Limpiar filtros
            </button>

        </div>

        <div class="table-responsive">

            <table class="table pr-table align-middle">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Producto</th>
                        <th>Categoría</th>
                        <th>Stock</th>
                        <th>Mínimo</th>
                        <th>Máximo</th>
                        <th>Estado</th>
                        <th>Precio</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody id="tablaProductos">
                    <tr>
                        <td colspan="9" class="pr-empty-message">
                            Cargando productos...
                        </td>
                    </tr>
                </tbody>

            </table>

        </div>

    </section>

</div>

@section Scripts {
    <script src="~/js/productos.js" asp-append-version="true"></script>
}
