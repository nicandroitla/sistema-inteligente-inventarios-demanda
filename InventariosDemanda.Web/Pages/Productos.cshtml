@page
@{
    ViewData["Title"] = "Productos";
}

<div class="dashboard-header">
    <h1>Productos</h1>
    <p>Gestión de los productos registrados en el inventario.</p>
</div>

<div class="system-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h5 class="mb-1">Lista de productos</h5>
            <div class="text-muted small">
                Información actual obtenida desde la API.
            </div>
        </div>

        <button type="button"
                class="btn btn-primary"
                onclick="mostrarFormulario()">
            + Nuevo producto
        </button>
    </div>

    <!-- FORMULARIO -->
    <div id="formularioProducto"
         style="display: none;"
         class="mb-4">

        <div class="border rounded p-4">
            <h5 id="tituloFormulario">Registrar producto</h5>

            <input type="hidden" id="productoId" />

            <div class="row g-3">

                <div class="col-md-6">
                    <label for="nombre" class="form-label">
                        Nombre
                    </label>
                    <input type="text"
                           id="nombre"
                           class="form-control"
                           placeholder="Nombre del producto"
                           maxlength="150" />
                </div>

                <div class="col-md-6">
                    <label for="categoria" class="form-label">
                        Categoría
                    </label>
                    <input type="text"
                           id="categoria"
                           class="form-control"
                           placeholder="Categoría"
                           maxlength="100" />
                </div>

                <div class="col-md-4">
                    <label for="stockActual" class="form-label">
                        Stock actual
                    </label>
                    <input type="number"
                           id="stockActual"
                           class="form-control"
                           min="0"
                           step="1" />
                </div>

                <div class="col-md-4">
                    <label for="stockMinimo" class="form-label">
                        Stock mínimo
                    </label>
                    <input type="number"
                           id="stockMinimo"
                           class="form-control"
                           min="0"
                           step="1" />
                </div>

                <div class="col-md-4">
                    <label for="stockMaximo" class="form-label">
                        Stock máximo
                    </label>
                    <input type="number"
                           id="stockMaximo"
                           class="form-control"
                           min="0"
                           step="1" />
                </div>

                <div class="col-md-4">
                    <label for="precio" class="form-label">
                        Precio
                    </label>
                    <input type="number"
                           id="precio"
                           class="form-control"
                           min="0"
                           step="0.01" />
                </div>

            </div>

            <div class="mt-4">
                <button type="button"
                        id="btnGuardar"
                        class="btn btn-primary"
                        onclick="guardarProducto()">
                    Guardar
                </button>

                <button type="button"
                        class="btn btn-secondary ms-2"
                        onclick="cancelarFormulario()">
                    Cancelar
                </button>
            </div>
        </div>
    </div>

    <!-- MENSAJES -->
    <div id="mensaje"
         class="mb-3"
         role="status"
         aria-live="polite"></div>

    <!-- TABLA -->
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Producto</th>
                    <th>Categoría</th>
                    <th>Stock</th>
                    <th>Mínimo</th>
                    <th>Máximo</th>
                    <th>Precio</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody id="tablaProductos">
                <tr>
                    <td colspan="8"
                        class="text-center text-muted">
                        Cargando productos...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        // ========================================
        // CONFIGURACIÓN
        // ========================================

        const API_URL = "/api-proxy/productos";

        let csrfToken = null;
        let guardando = false;
        let eliminando = false;

        // ========================================
        // OBTENER TOKEN CSRF
        // ========================================

        async function obtenerCsrfToken() {
            if (csrfToken) {
                return csrfToken;
            }

            const respuesta = await fetch(
                "/api-proxy/csrf-token",
                {
                    credentials: "same-origin",
                    cache: "no-store"
                }
            );

            if (respuesta.status === 401) {
                throw new Error(
                    "Tu sesión ha expirado. Inicia sesión nuevamente."
                );
            }

            if (!respuesta.ok) {
                throw new Error(
                    "No fue posible obtener el token de seguridad."
                );
            }

            const datos = await respuesta.json();

            if (!datos.token) {
                throw new Error(
                    "El servidor no devolvió un token de seguridad."
                );
            }

            csrfToken = datos.token;
            return csrfToken;
        }

        // ========================================
        // MOSTRAR MENSAJES
        // ========================================

        function mostrarMensaje(texto, tipo) {
            const contenedor =
                document.getElementById("mensaje");

            contenedor.replaceChildren();

            const alerta = document.createElement("div");
            alerta.className = `alert alert-${tipo}`;
            alerta.textContent = texto;

            contenedor.appendChild(alerta);
        }

        // ========================================
        // LEER RESPUESTA DE LA API
        // ========================================

        async function leerRespuesta(respuesta) {
            const texto = await respuesta.text();

            let datos = {};

            try {
                datos = texto ? JSON.parse(texto) : {};
            } catch {
                datos = {};
            }

            if (!respuesta.ok) {
                if (respuesta.status === 401) {
                    throw new Error(
                        "Tu sesión ha expirado. Inicia sesión nuevamente."
                    );
                }

                if (respuesta.status === 403) {
                    throw new Error(
                        "No tienes autorización para realizar esta operación."
                    );
                }

                if (respuesta.status === 400 &&
                    (datos.mensaje || "").includes("Token de seguridad")) {
                    csrfToken = null;
                }

                throw new Error(
                    datos.mensaje ||
                    datos.message ||
                    datos.detail ||
                    datos.title ||
                    `Error HTTP ${respuesta.status}.`
                );
            }

            return datos;
        }

        // ========================================
        // CARGAR PRODUCTOS
        // ========================================

        async function cargarProductos() {
            const tabla =
                document.getElementById("tablaProductos");

            try {
                const respuesta = await fetch(API_URL, {
                    credentials: "same-origin",
                    cache: "no-store"
                });

                const resultado = await leerRespuesta(respuesta);

                const productos = Array.isArray(resultado)
                    ? resultado
                    : Array.isArray(resultado.value)
                        ? resultado.value
                        : [];

                tabla.replaceChildren();

                if (productos.length === 0) {
                    const fila = tabla.insertRow();
                    const celda = fila.insertCell();

                    celda.colSpan = 8;
                    celda.className =
                        "text-center text-muted";
                    celda.textContent =
                        "No hay productos registrados.";

                    return;
                }

                productos.forEach(producto => {
                    const fila = tabla.insertRow();

                    const valores = [
                        producto.id,
                        producto.nombre ?? "",
                        producto.categoria ?? "",
                        producto.stockActual ?? 0,
                        producto.stockMinimo ?? 0,
                        producto.stockMaximo ?? 0,
                        `$${Number(
                            producto.precio ?? 0
                        ).toLocaleString("es-DO", {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        })}`
                    ];

                    valores.forEach((valor, indice) => {
                        const celda = fila.insertCell();

                        if (indice === 1) {
                            const nombre =
                                document.createElement("strong");

                            nombre.textContent = valor;
                            celda.appendChild(nombre);
                        } else {
                            celda.textContent = valor;
                        }
                    });

                    const acciones = fila.insertCell();

                    const btnEditar =
                        document.createElement("button");

                    btnEditar.type = "button";
                    btnEditar.className =
                        "btn btn-sm btn-outline-primary me-1";
                    btnEditar.textContent = "Editar";

                    btnEditar.addEventListener(
                        "click",
                        () => editarProducto(producto.id)
                    );

                    const btnEliminar =
                        document.createElement("button");

                    btnEliminar.type = "button";
                    btnEliminar.className =
                        "btn btn-sm btn-outline-danger";
                    btnEliminar.textContent = "Eliminar";

                    btnEliminar.addEventListener(
                        "click",
                        () => eliminarProducto(producto.id)
                    );

                    acciones.appendChild(btnEditar);
                    acciones.appendChild(btnEliminar);
                });

            } catch (error) {
                tabla.replaceChildren();

                const fila = tabla.insertRow();
                const celda = fila.insertCell();

                celda.colSpan = 8;
                celda.className =
                    "text-center text-danger";
                celda.textContent =
                    "No fue posible cargar los productos.";

                mostrarMensaje(error.message, "danger");
            }
        }

        // ========================================
        // FORMULARIO
        // ========================================

        function limpiarFormulario() {
            [
                "productoId",
                "nombre",
                "categoria",
                "stockActual",
                "stockMinimo",
                "stockMaximo",
                "precio"
            ].forEach(id => {
                document.getElementById(id).value = "";
            });
        }

        function mostrarFormulario() {
            limpiarFormulario();

            document.getElementById(
                "tituloFormulario"
            ).textContent = "Registrar producto";

            document.getElementById(
                "formularioProducto"
            ).style.display = "block";
        }

        function cancelarFormulario() {
            limpiarFormulario();

            document.getElementById(
                "formularioProducto"
            ).style.display = "none";
        }

        // ========================================
        // GUARDAR O ACTUALIZAR
        // ========================================

        async function guardarProducto() {
            if (guardando) {
                return;
            }

            const id =
                document.getElementById("productoId").value;

            const nombre =
                document.getElementById("nombre").value.trim();

            const categoria =
                document.getElementById("categoria").value.trim();

            const stockActualTexto =
                document.getElementById("stockActual").value;

            const stockMinimoTexto =
                document.getElementById("stockMinimo").value;

            const stockMaximoTexto =
                document.getElementById("stockMaximo").value;

            const precioTexto =
                document.getElementById("precio").value;

            if (!nombre || !categoria) {
                mostrarMensaje(
                    "El nombre y la categoría son obligatorios.",
                    "warning"
                );
                return;
            }

            if (
                stockActualTexto === "" ||
                stockMinimoTexto === "" ||
                stockMaximoTexto === "" ||
                precioTexto === ""
            ) {
                mostrarMensaje(
                    "Completa todos los campos numéricos.",
                    "warning"
                );
                return;
            }

            const stockActual = Number(stockActualTexto);
            const stockMinimo = Number(stockMinimoTexto);
            const stockMaximo = Number(stockMaximoTexto);
            const precio = Number(precioTexto);

            if (
                !Number.isInteger(stockActual) ||
                !Number.isInteger(stockMinimo) ||
                !Number.isInteger(stockMaximo) ||
                stockActual < 0 ||
                stockMinimo < 0 ||
                stockMaximo < 0 ||
                !Number.isFinite(precio) ||
                precio < 0
            ) {
                mostrarMensaje(
                    "Introduce valores numéricos válidos y no negativos.",
                    "warning"
                );
                return;
            }

            if (stockMinimo > stockMaximo) {
                mostrarMensaje(
                    "El stock mínimo no puede superar el stock máximo.",
                    "warning"
                );
                return;
            }

            if (stockActual > stockMaximo) {
                mostrarMensaje(
                    "El stock actual no puede superar el stock máximo.",
                    "warning"
                );
                return;
            }

            const producto = {
                nombre,
                categoria,
                stockActual,
                stockMinimo,
                stockMaximo,
                precio
            };

            const btnGuardar =
                document.getElementById("btnGuardar");

            guardando = true;
            btnGuardar.disabled = true;
            btnGuardar.textContent = "Guardando...";

            try {
                const token = await obtenerCsrfToken();

                const respuesta = await fetch(
                    id ? `${API_URL}/${id}` : API_URL,
                    {
                        method: id ? "PUT" : "POST",
                        credentials: "same-origin",
                        headers: {
                            "Content-Type": "application/json",
                            "X-CSRF-TOKEN": token
                        },
                        body: JSON.stringify(producto)
                    }
                );

                await leerRespuesta(respuesta);

                cancelarFormulario();

                mostrarMensaje(
                    id
                        ? "Producto actualizado correctamente."
                        : "Producto guardado correctamente.",
                    "success"
                );

                await cargarProductos();

            } catch (error) {
                mostrarMensaje(error.message, "danger");

            } finally {
                guardando = false;
                btnGuardar.disabled = false;
                btnGuardar.textContent = "Guardar";
            }
        }

        // ========================================
        // EDITAR PRODUCTO
        // ========================================

        async function editarProducto(id) {
            try {
                const respuesta = await fetch(
                    `${API_URL}/${id}`,
                    {
                        credentials: "same-origin",
                        cache: "no-store"
                    }
                );

                const producto =
                    await leerRespuesta(respuesta);

                document.getElementById(
                    "productoId"
                ).value = producto.id;

                document.getElementById(
                    "nombre"
                ).value = producto.nombre ?? "";

                document.getElementById(
                    "categoria"
                ).value = producto.categoria ?? "";

                document.getElementById(
                    "stockActual"
                ).value = producto.stockActual ?? 0;

                document.getElementById(
                    "stockMinimo"
                ).value = producto.stockMinimo ?? 0;

                document.getElementById(
                    "stockMaximo"
                ).value = producto.stockMaximo ?? 0;

                document.getElementById(
                    "precio"
                ).value = producto.precio ?? 0;

                document.getElementById(
                    "tituloFormulario"
                ).textContent = "Editar producto";

                const formulario =
                    document.getElementById("formularioProducto");

                formulario.style.display = "block";

                formulario.scrollIntoView({
                    behavior: "smooth",
                    block: "start"
                });

            } catch (error) {
                mostrarMensaje(error.message, "danger");
            }
        }

        // ========================================
        // ELIMINAR PRODUCTO
        // ========================================

        async function eliminarProducto(id) {
            if (eliminando) {
                return;
            }

            if (!confirm(
                "¿Deseas eliminar este producto?"
            )) {
                return;
            }

            eliminando = true;

            try {
                const token = await obtenerCsrfToken();

                const respuesta = await fetch(
                    `${API_URL}/${id}`,
                    {
                        method: "DELETE",
                        credentials: "same-origin",
                        headers: {
                            "X-CSRF-TOKEN": token
                        }
                    }
                );

                await leerRespuesta(respuesta);

                mostrarMensaje(
                    "Producto eliminado correctamente.",
                    "success"
                );

                await cargarProductos();

            } catch (error) {
                mostrarMensaje(error.message, "danger");

            } finally {
                eliminando = false;
            }
        }

        // ========================================
        // INICIALIZAR
        // ========================================

        cargarProductos();
    </script>
}
